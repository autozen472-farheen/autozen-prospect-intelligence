FROM python:3.12-slim
WORKDIR /app
COPY AutoZen_Prospect_Intelligence_v1.4.2_build_20260913_01.zip /tmp/autozen-release.zip
RUN python -m zipfile -e /tmp/autozen-release.zip /app \
    && pip install --no-cache-dir -r requirements.lock \
    && python -m pytest \
    && useradd --uid 10001 --create-home engine
ENV DATA_MODE=mock APP_ENVIRONMENT=demo NARRATIVE_MODE=template
ENV ENABLE_LIVE_RUNS=false DAILY_LIVE_RUN_LIMIT=1
ENV STORAGE_BACKEND=auto DATABASE_PATH=/tmp/autozen-prospect-intelligence.db
ENV PERSISTENT_STORAGE_CONFIRMED=false
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER engine
EXPOSE 8080
CMD ["python", "-m", "scripts.run_autozen_server"]
